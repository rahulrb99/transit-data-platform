APP_ENVIRONMENT=production
# Required: use the ECR digest form, for example
# 123456789012.dkr.ecr.us-east-1.amazonaws.com/transit@sha256:<64 hex characters>
APP_IMAGE=

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=transit
POSTGRES_USER=transit
POSTGRES_PASSWORD=

RAW_DATA_ROOT=/app/data/raw
RAW_ARCHIVE_ROOT=/app/data/archive/raw
PROCESSED_DATA_ROOT=/app/data/processed
MBTA_GTFS_STATIC_URL=https://cdn.mbta.com/MBTA_GTFS.zip
MBTA_VEHICLE_POSITIONS_URL=https://cdn.mbta.com/realtime/VehiclePositions.pb
MBTA_POLL_INTERVAL_SECONDS=15
MBTA_HTTP_TIMEOUT_SECONDS=30
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
VEHICLE_POSITIONS_TOPIC=vehicle_positions
VEHICLE_POSITIONS_CONSUMER_GROUP=vehicle-position-postgres-writer
MBTA_CONSUMER_BATCH_SIZE=100
MBTA_REALTIME_STALE_THRESHOLD_SECONDS=60
DASHBOARD_REFRESH_INTERVAL_SECONDS=30
DASHBOARD_VEHICLE_MAX_AGE_SECONDS=90
RUNTIME_HEALTH_MAX_AGE_SECONDS=300

REALTIME_RETENTION_DAYS=14
METRICS_RETENTION_DAYS=30
RAW_PAYLOAD_RETENTION_DAYS=7
RETENTION_BATCH_SIZE=1000
RETENTION_MAX_BATCHES=250
ARCHIVE_MIN_FREE_BYTES=2147483648
ARCHIVE_BACKEND=s3
ARCHIVE_STATUS_PATH=/app/data/archive/raw/.status/s3-archive.json
BACKUP_STATUS_PATH=backups/.s3-upload-status.json
S3_BUCKET_NAME=
AWS_REGION=
S3_RAW_ARCHIVE_PREFIX=raw-archives
S3_POSTGRES_BACKUP_PREFIX=postgres-backups
S3_BACKUP_MAX_AGE_HOURS=26
REDPANDA_TOPIC_RETENTION_MS=604800000
REDPANDA_TOPIC_RETENTION_BYTES=1073741824

PUBLIC_HOSTNAME=transit.example.com
CADDY_ACME_EMAIL=admin@example.com
